# =============================================================================
# YL Sport Tights - Environment Variables Example
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in your actual values in .env.local
# 3. Never commit .env.local to Git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

# -----------------------------------------------------------------------------
# Admin Authentication (Simple Session-Based)
# -----------------------------------------------------------------------------
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Cardcom Payment Gateway
# -----------------------------------------------------------------------------
CARDCOM_TERMINAL_NUMBER=""
CARDCOM_USERNAME=""
CARDCOM_API_KEY=""
CARDCOM_RETURN_URL="https://yl-sport.co.il/order/confirmation"
CARDCOM_NOTIFY_URL="https://yl-sport.co.il/api/payment/callback"
CARDCOM_SANDBOX_MODE="true"
# Comma-separated list of allowed Cardcom server IPs for callback verification
CARDCOM_IP_WHITELIST="192.168.1.1,192.168.1.2"

# -----------------------------------------------------------------------------
# Resend (Email Service)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="YL Sport <noreply@yl-sport.co.il>"
RESEND_REPLY_TO_EMAIL=""

# -----------------------------------------------------------------------------
# SMS Service - "שלח מסר" (Shlach Meser) Israeli Provider
# -----------------------------------------------------------------------------
SHLACH_MESER_API_KEY=""
SHLACH_MESER_SENDER="YL-Sport"
# API documentation to be provided by vendor

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""

# Meta Conversions API (server-side Purchase events for iOS / ad-blocker recovery).
# Generate at: Events Manager → Settings → Conversions API → Generate access token.
# Use a System User token in production so it doesn't expire.
META_CAPI_ACCESS_TOKEN=""

# TikTok Events API (server-to-server pixel events).
# Generate at: TikTok Events Manager → Web Events → Settings → Events API → Generate access token.
TIKTOK_EVENTS_API_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://yl-sport.co.il"
NEXT_PUBLIC_APP_URL="https://yl-sport.co.il"
ADMIN_EMAIL="admin@yl-sport.co.il"
ADMIN_DEFAULT_EMAIL="admin@yl-sport.co.il"
ADMIN_DEFAULT_PASSWORD=""

# -----------------------------------------------------------------------------
# Product & Business Settings
# -----------------------------------------------------------------------------
PRODUCT_PRICE="299"
SHIPPING_COST="30"
FREE_PICKUP_CITY="Beer Sheva"
ORDER_NUMBER_PREFIX="YL"
ORDER_NUMBER_START="1001"

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SMS="false"
ENABLE_DISCOUNT_CODES="true"
ENABLE_ANALYTICS="true"
ENABLE_ADMIN_REGISTRATION="false"

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"
SKIP_EMAIL_SEND="false"
SKIP_SMS_SEND="true"

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="https://yl-sport.co.il,http://localhost:3000"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"
SESSION_MAX_AGE="86400"
